# Reglas del IDS del escenario de fuzzing.
#
# Son dos señales independientes a propósito: el agente de usuario por defecto de las herramientas y
# la tasa de respuestas 404. El alumno tiene que entender las dos para pasar sin alertar.

alert http any any -> any any ( \
    msg:"LAB ffuf user-agent por defecto"; \
    flow:to_server,established; \
    http.user_agent; content:"Fuzz Faster U Fool"; nocase; \
    classtype:web-application-scan; \
    sid:1000001; rev:1; )

alert http any any -> any any ( \
    msg:"LAB fuerza bruta de directorios (muchos 404)"; \
    flow:to_client,established; \
    http.stat_code; content:"404"; \
    threshold: type both, track by_dst, count 50, seconds 10; \
    classtype:web-application-scan; \
    sid:1000002; rev:1; )
