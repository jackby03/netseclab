#cloud-config
# Semilla de arranque para construir la caja. Solo se usa durante la construcción.

hostname: netseclab
fqdn: netseclab.lab
manage_etc_hosts: true

users:
  - name: lab
    sudo: ALL=(ALL) NOPASSWD:ALL
    shell: /bin/bash
    lock_passwd: false
    # La contraseña va EN el usuario: `password:` a nivel raíz se aplica al
    # usuario por defecto de la imagen, no a este. El SSH sigue siendo solo con clave.
    plain_text_passwd: netseclab
    ssh_authorized_keys:
      - __PUBKEY__

ssh_pwauth: false
disable_root: true

# Sin package_update: el provisionamiento instala lo que necesita, y así cloud-init
# no se pelea por el lock de apt con él.

write_files:
  - path: /etc/motd
    content: |
      netseclab — laboratorio de seguridad en redes
      Escribe `lab --help` para empezar.

runcmd:
  - sed -i 's/^#\?PasswordAuthentication.*/PasswordAuthentication no/' /etc/ssh/sshd_config
