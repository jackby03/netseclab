.encoding = "UTF-8"
config.version = "8"
virtualHW.version = "19"
displayName = "netseclab"
guestOS = "debian12-64"
memsize = "2048"
numvcpus = "2"
cpuid.coresPerSocket = "2"

# Puentes PCIe: sin ellos VMware no encuentra ranura para una tarjeta PCIe como
# vmxnet3, y al añadirla desde la interfaz acaba poniendo e1000, que el kernel
# cloud de Debian no trae. Estos son los que VMware escribe por su cuenta.
pciBridge0.present = "TRUE"
pciBridge4.present = "TRUE"
pciBridge4.virtualDev = "pcieRootPort"
pciBridge4.functions = "8"
pciBridge5.present = "TRUE"
pciBridge5.virtualDev = "pcieRootPort"
pciBridge5.functions = "8"
pciBridge6.present = "TRUE"
pciBridge6.virtualDev = "pcieRootPort"
pciBridge6.functions = "8"
pciBridge7.present = "TRUE"
pciBridge7.virtualDev = "pcieRootPort"
pciBridge7.functions = "8"

# Disco por SATA: compatible con el kernel cloud de Debian.
sata0.present = "TRUE"
sata0:0.present = "TRUE"
sata0:0.fileName = "netseclab.vmdk"
sata0:0.deviceType = "disk"

# Tarjeta paravirtualizada de VMware: es la que trae ese kernel.
ethernet0.present = "TRUE"
ethernet0.connectionType = "nat"
ethernet0.virtualDev = "vmxnet3"
ethernet0.addressType = "generated"
ethernet0.startConnected = "TRUE"

usb.present = "FALSE"
sound.present = "FALSE"
floppy0.present = "FALSE"
ide1:0.present = "FALSE"
mks.enable3d = "FALSE"

nvram = "netseclab.nvram"
virtualHW.productCompatibility = "hosted"
tools.syncTime = "TRUE"
tools.upgrade.policy = "useGlobal"

# Sin virtualización anidada: dentro de la caja solo hay contenedores.
msg.autoAnswer = "FALSE"
